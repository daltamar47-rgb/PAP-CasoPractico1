@using PAP.DataAccess.Entities
@model PAP.Mvc.Models.CrudPageModel<BookAuthorLink>

@{
    ViewBag.Title = Model.Title;
}

<main>
    @Html.Partial("_CrudHeader", Model)

    @if (Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">Libro</th>
                        <th scope="col">Autor</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        var rowValues = new
                        {
                            OriginalBookId = item.BookId,
                            OriginalAuthorId = item.AuthorId,
                            item.BookId,
                            item.AuthorId
                        };
                        var deleteValues = new Dictionary<string, string>
                        {
                            { "bookId", item.BookId.ToString() },
                            { "authorId", item.AuthorId.ToString() }
                        };
                        <tr>
                            <td>@item.BookTitle</td>
                            <td>@item.AuthorName</td>
                            @Html.Partial("_RowActions", Model.ActionsFor(rowValues, deleteValues))
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        @Html.Partial("_EmptyState", Model)
    }

    @Html.Partial("_CrudModals", Model)
</main>
