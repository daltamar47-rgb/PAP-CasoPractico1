@using PAP.Mvc.Infrastructure
@model PAP.Mvc.Models.CrudPageModel<PAP.DataAccess.Customer>

@{
    ViewBag.Title = Model.Title;
}

<main>
    @Html.Partial("_CrudHeader", Model)

    @if (Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Nombre</th>
                        <th scope="col">Correo</th>
                        <th scope="col">Teléfono</th>
                        <th scope="col">Activo</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.FirstName @item.LastName</td>
                            <td>@item.Email</td>
                            <td>@Display.Text(item.Phone)</td>
                            <td>@Display.Flag(item.IsActive)</td>
                            @Html.Partial("_RowActions", Model.ActionsFor(item, item.Id))
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        @Html.Partial("_EmptyState", Model)
    }

    @Html.Partial("_CrudModals", Model)
</main>
