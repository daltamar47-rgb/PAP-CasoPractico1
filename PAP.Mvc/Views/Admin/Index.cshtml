@model IReadOnlyList<PAP.Generators.Core.GeneratorStatus>

@{
    ViewBag.Title = "Admin";
}

<main>
    <div class="mb-4">
        <h1 class="h2 mb-1">Admin - Generación de datos</h1>
        <p class="text-muted mb-0">
            Las tablas sin dependencias se pueden generar primero. Las demás se habilitan cuando las tablas de las que dependen ya tienen datos.
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success" role="alert">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle w-auto">
            <thead class="table-dark">
                <tr>
                    <th scope="col">Tabla</th>
                    <th scope="col">Estado</th>
                    <th scope="col" class="text-end">Generar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var status in Model)
                {
                    var badge = status.HasData ? "text-bg-success" : status.CanGenerate ? "text-bg-primary" : "text-bg-secondary";
                    <tr>
                        <td>@status.TableName</td>
                        <td><span class="badge @badge">@status.Description</span></td>
                        <td class="text-end">
                            @using (Html.BeginForm("Generate", "Admin", FormMethod.Post))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="tableName" value="@status.TableName" />
                                <button type="submit" class="btn btn-sm btn-primary" disabled="@(status.CanGenerate ? null : "disabled")">Generar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</main>
