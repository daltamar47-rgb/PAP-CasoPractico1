@using PAP.Mvc.Infrastructure
@model PAP.Mvc.Models.CrudPageModel<PAP.DataAccess.Inventory>

@{
    ViewBag.Title = Model.Title;
}

<main>
    @Html.Partial("_CrudHeader", Model)

    @if (Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Libro</th>
                        <th scope="col" class="text-end">En stock</th>
                        <th scope="col" class="text-end">Nivel de reorden</th>
                        <th scope="col">Último reabastecimiento</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@Model.LookupText("BookId", item.BookId)</td>
                            <td class="text-end">@item.QuantityInStock</td>
                            <td class="text-end">@item.ReorderLevel</td>
                            <td>@Display.DateAndTime(item.LastRestockedAt)</td>
                            @Html.Partial("_RowActions", Model.ActionsFor(item, item.Id))
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        @Html.Partial("_EmptyState", Model)
    }

    @Html.Partial("_CrudModals", Model)
</main>
