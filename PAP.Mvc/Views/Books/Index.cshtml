@using PAP.Mvc.Infrastructure
@model PAP.Mvc.Models.CrudPageModel<PAP.DataAccess.Book>

@{
    ViewBag.Title = Model.Title;
}

<main>
    @Html.Partial("_CrudHeader", Model)

    @if (Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Título</th>
                        <th scope="col">ISBN</th>
                        <th scope="col">Editorial</th>
                        <th scope="col">Categoría</th>
                        <th scope="col">Género</th>
                        <th scope="col" class="text-end">Precio</th>
                        <th scope="col">En stock</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Title</td>
                            <td>@Display.Text(item.ISBN)</td>
                            <td>@Model.LookupText("PublisherId", item.PublisherId)</td>
                            <td>@Model.LookupText("CategoryId", item.CategoryId)</td>
                            <td>@Model.LookupText("GenreId", item.GenreId)</td>
                            <td class="text-end">@Display.Money(item.Price)</td>
                            <td>@Display.Flag(item.IsInStock)</td>
                            @Html.Partial("_RowActions", Model.ActionsFor(item, item.Id))
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        @Html.Partial("_EmptyState", Model)
    }

    @Html.Partial("_CrudModals", Model)
</main>
