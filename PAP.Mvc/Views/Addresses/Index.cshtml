@using PAP.Mvc.Infrastructure
@model PAP.Mvc.Models.CrudPageModel<PAP.DataAccess.Address>

@{
    ViewBag.Title = Model.Title;
}

<main>
    @Html.Partial("_CrudHeader", Model)

    @if (Model.Items.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Tipo</th>
                        <th scope="col">Dirección</th>
                        <th scope="col">Ciudad</th>
                        <th scope="col">País</th>
                        <th scope="col">Predeterminada</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@Model.LookupText("CustomerId", item.CustomerId)</td>
                            <td>@item.AddressType</td>
                            <td>@item.Street</td>
                            <td>@item.City</td>
                            <td>@item.Country</td>
                            <td>@Display.Flag(item.IsDefault)</td>
                            @Html.Partial("_RowActions", Model.ActionsFor(item, item.Id))
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        @Html.Partial("_EmptyState", Model)
    }

    @Html.Partial("_CrudModals", Model)
</main>
